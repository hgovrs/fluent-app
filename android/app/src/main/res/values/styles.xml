<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FluentTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/brand_purple</item>
    </style>
    <style name="LaunchTheme" parent="FluentTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="FluentTheme" />
</resources>
